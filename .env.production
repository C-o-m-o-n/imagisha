# Public, build-time values. Next.js inlines NEXT_PUBLIC_* into the JS bundle during `next build`,
# so they must be present at build time (they are visible to every browser anyway: never put secrets here).
# Server-only secrets live in Cloudflare: Worker > Settings > Variables and Secrets (see .dev.vars.example).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dG9wcy1vcG9zc3VtLTI2LmNsZXJrLmFjY291bnRzLmRldiQ
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dqb01jzej
